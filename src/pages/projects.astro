---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<BaseLayout title="Projects — Cory Simenson">
  <Header />

  <main class="projects-container">
    <h1>Projects</h1>
    <p class="intro">
      A collection of systems, tools, and infrastructure I build and maintain.
      These projects reflect my operator-style workflows, long-term engineering
      approach, and focus on clarity, stability, and maintainability.
    </p>

    <div class="projects-list">
      {projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          link={`/projects/${project.id}`}
        />
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .projects-container {
    max-width: 760px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .intro {
    line-height: 1.6;
    margin-bottom: 2rem;
    color: var(--text-muted);
  }
</style>
