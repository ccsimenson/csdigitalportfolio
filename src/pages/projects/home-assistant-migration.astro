---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Home Assistant Supervisor Migration — Project">
  <Header />

  <main style="max-width: 760px; margin: 2rem auto; padding: 0 1rem;">
    <h1>Home Assistant Supervisor Migration</h1>

    <p style="line-height: 1.6; margin-bottom: 2rem;">
      Transitioning my smart home ecosystem from Google Home to Home Assistant
      Supervisor, including device migration, automation rebuilds, and stability
      improvements.
    </p>

    <section style="margin-top: 2rem;">
      <h2>Overview</h2>
      <p style="line-height: 1.6;">
        This project focuses on replacing Google Home with a fully local, stable,
        and extensible Home Assistant Supervisor deployment. The migration includes
        device onboarding, automation recreation, and long-term reliability work.
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Technical Details</h2>
      <p style="line-height: 1.6;">
        • Supervisor-based deployment  
        • Add-on ecosystem  
        • Device migration strategy  
        • Automation rebuilds  
        • Stability and uptime improvements  
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Status</h2>
      <p style="line-height: 1.6;">
        Migration in progress. Core devices onboarded; automation rebuild underway.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
