---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="Linux Multi-System Environment — Project">
  <Header />

  <main style="max-width: 760px; margin: 2rem auto; padding: 0 1rem;">
    <h1>Linux Multi-System Environment</h1>

    <p style="line-height: 1.6; margin-bottom: 2rem;">
      Maintaining a coordinated Linux environment across multiple machines with
      shared workflows, synchronized configs, and hardware optimization.
    </p>

    <section style="margin-top: 2rem;">
      <h2>Overview</h2>
      <p style="line-height: 1.6;">
        This project builds a unified Linux ecosystem across Zora, Pavilion, and
        Victus. It focuses on consistent workflows, shared configuration patterns,
        and hardware-aware tuning.
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Technical Details</h2>
      <p style="line-height: 1.6;">
        • Shared operator-style workflows  
        • Config synchronization  
        • Hardware optimization  
        • Multi-system coordination  
        • Stability and maintainability focus  
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Status</h2>
      <p style="line-height: 1.6;">
        Ongoing refinement. Workflow consolidation and config synchronization underway.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
