---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout title="KVM/QEMU Virtualization Stack — Project">
  <Header />

  <main style="max-width: 760px; margin: 2rem auto; padding: 0 1rem;">
    <h1>KVM/QEMU Virtualization Stack</h1>

    <p style="line-height: 1.6; margin-bottom: 2rem;">
      Building stable multi-machine virtualization workflows across Zora, Pavilion,
      and Victus using KVM/QEMU, libvirt, and structured operator-style deployment.
    </p>

    <section style="margin-top: 2rem;">
      <h2>Overview</h2>
      <p style="line-height: 1.6;">
        This project establishes a unified virtualization environment across multiple
        Linux systems. It focuses on predictable VM deployment, shared configuration
        patterns, and hardware-aware optimization.
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Technical Details</h2>
      <p style="line-height: 1.6;">
        • KVM/QEMU hypervisor stack  
        • libvirt management  
        • qcow2 storage layout  
        • Operator-style VM provisioning  
        • Multi-machine coordination  
      </p>
    </section>

    <section style="margin-top: 2rem;">
      <h2>Status</h2>
      <p style="line-height: 1.6;">
        Active development. Core VMs deployed; storage layout refinement ongoing.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
